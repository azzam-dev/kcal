# Copy to .env.local and fill in from the Supabase dashboard
# (Project Settings -> API). .env.local is git-ignored; this file is not.
#
# Both are NEXT_PUBLIC_, so both are inlined into the client bundle AT BUILD
# TIME, not read at runtime. Two consequences:
#   1. Never put a secret here. The publishable key is safe to ship because
#      row-level security, not key secrecy, is what protects the data.
#   2. Changing either value on the host requires a rebuild — a cached redeploy
#      will serve the old bundle with the old values.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
